    "schemas": "node scripts/schemas.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.mjs",
    "a11y": "node scripts/a11y.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "isbot": "5.2.2",
