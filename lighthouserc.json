{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/travel/himachal-pradesh/triund-2026",
        "http://localhost:4173/travel/himachal-pradesh"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 25600
          }
        ],
        "resource-summary:font:size": [
          "warn",
          {
            "maxNumericValue": 163840
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1258291
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
