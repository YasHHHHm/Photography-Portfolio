# Cloudflare Pages response headers (PRD section 6).
#
# Cloudflare joins the values of a header set by more than one matching rule,
# so Cache-Control is only set on specific paths. Everything else gets the
# Pages default, "public, max-age=0, must-revalidate".

# Hashed file names never change, so they are cached forever.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Social images keep a stable name, so they are cached for one day.
/og/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
