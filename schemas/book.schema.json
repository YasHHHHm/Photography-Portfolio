{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The country or region, e.g. \"India\"."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One or two sentences about this place."
    },
    "cover": {
      "description": "Optional cover photo, written as \"trip-folder/file.jpg\". Defaults to the newest trip's cover.",
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4}|images)\\/[^/\\\\]+\\.(jpe?g|png|avif)$",
      "patternErrorMessage": "Write it as \"kerala-2026/backwaters-01.jpg\" or \"images/map.jpg\"",
      "examples": [
        "kerala-2026/backwaters-01.jpg"
      ]
    },
    "video": {
      "description": "A clip that plays silently behind the book title, written as \"trip-folder/clip.mp4\". Optional.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4}\\/[^/\\\\]+\\.(mp4|mov|m4v)$",
          "patternErrorMessage": "Write it as \"kerala-2026/backwaters-loop.mp4\"",
          "examples": [
            "kerala-2026/backwaters-loop.mp4"
          ]
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "order": {
      "default": 99,
      "description": "Position on the Travel page. Lower numbers come first.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "title",
    "summary"
  ],
  "additionalProperties": false,
  "description": "A book: a country or region that collects trips."
}
